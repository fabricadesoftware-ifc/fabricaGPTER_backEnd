# Gere uma chave local; nunca versione o .env.
SECRET_KEY=
DJANGO_DEBUG=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=h
CSRF_TRUSTED_ORIGINS=
# Opcional: omita SQLITE_PATH para usar local.sqlite3 na raiz.
# SQLITE_PATH=
# Opcoes abaixo usam os padroes do settings quando omitidas.
# SESSION_COOKIE_AGE=28800
# Cookies Secure e redirecionamento HTTPS sao ativados quando DJANGO_DEBUG=false.
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=0
# LOGIN_THROTTLE_RATE=10/min
